PORT=8080
# must be the same value as core's JWT_SECRET
JWT_SECRET=change-me
CORE_URL=http://localhost:4001
# the other services; leave one empty and the gateway answers 503 for its paths
REFLECT_URL=http://localhost:4002
BRIDGE_URL=http://localhost:4003
# empty = allow any origin (local dev). In production set it to the web URL, e.g. https://sevasetu.vercel.app
WEB_ORIGIN=
