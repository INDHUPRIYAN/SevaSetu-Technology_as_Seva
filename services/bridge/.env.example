PORT=4003

# LLM (Groq, OpenAI-compatible chat API) — understanding, extraction, follow-up questions, the dignity
# rewrite (console.groq.com → API Keys). Optional: with no key OR no model name, every AI job answers with
# its rule-based fallback. GROQ_API_KEY / GROQ_MODEL are accepted too. No model name is written in the code.
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# json_schema (constrained decoding; Groq supports it for openai/gpt-oss-* and qwen3 models) or json_object
# (any model; the bridge still checks every answer against the schema and retries once)
LLM_RESPONSE_FORMAT=json_schema
# LLM_BASE_URL=https://api.groq.com/openai/v1/chat/completions

# Bhashini — speech to text, translation and text to speech for Tamil / Hindi / English
# (bhashini.gov.in → profile → generate key). Optional: without keys the browser's own speech APIs are used.
LANGUAGE_PROVIDER=bhashini
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=
# public values, listed in docs/BHASHINI.md
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd
BHASHINI_TTS_GENDER=female

# how long Post a Need waits for each provider before using the fallback draft (milliseconds)
DRAFT_TIMEOUT_MS=8000
TRANSLATE_TIMEOUT_MS=4000
