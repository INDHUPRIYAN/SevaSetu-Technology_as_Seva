{
  "name": "sevasetu-person-a",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "dev": "concurrently -n gateway,core,web -c yellow,cyan,magenta \"npm:dev -w services/gateway\" \"npm:dev -w services/core\" \"npm:dev -w apps/web\"",
    "mono": "node mono.js",
    "seed": "node seed/seed-core.js",
    "test:api": "node seed/seed-core.js && node scripts/api-test.js",
    "build": "npm run build -w apps/web",
    "test:ui": "node seed/seed-core.js && node scripts/ui-test.js",
    "test:ui:desktop": "node seed/seed-core.js && node scripts/ui-test.js --desktop"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "playwright-core": "^1.63.0"
  }
}
