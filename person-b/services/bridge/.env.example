PORT=4003

# Groq — drafts the need card (console.groq.com → API Keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Bhashini — Tamil speech to text and Tamil to English (bhashini.gov.in → profile → generate key)
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=
# public values, listed in docs/BHASHINI.md
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd

# how long Post a Need waits for each provider before using the fallback draft (milliseconds)
DRAFT_TIMEOUT_MS=8000
TRANSLATE_TIMEOUT_MS=4000
