{
  "name": "person-b-dev",
  "private": true,
  "type": "module",
  "description": "Dev-only harness: runs Person B's pages with stand-ins for Person A's shell. Not merged (see docs/INTEGRATION.md).",
  "scripts": {
    "dev": "concurrently -k -n stack,web \"node server/stack.cjs\" \"vite\"",
    "stack": "node server/stack.cjs",
    "web": "vite",
    "build": "vite build",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.2.0",
    "jsdom": "^30.1.2",
    "jsonwebtoken": "^9.0.3",
    "mongodb-memory-server": "^11.3.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
