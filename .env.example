# SevaSetu — every setting and every token, in ONE file (git ignores .env; .env.example is the tracked template).
# Each service reads this file on start; a services/<name>/.env, if present, overrides it for that service only.
# Names that would clash between services carry a prefix (CORE_, REFLECT_, GATEWAY_, BRIDGE_).

# ---------- databases (MongoDB: local mongod or Atlas) ----------
CORE_MONGO_URI=mongodb://127.0.0.1:27017/seva_core
REFLECT_MONGO_URI=mongodb://127.0.0.1:27017/seva_reflect

# ---------- auth: core signs the demo token, the gateway verifies it (must be the same value) ----------
JWT_SECRET=change-me-to-a-long-random-string

# ---------- ports (defaults in code: 8080, 4001, 4002, 4003) and where the gateway finds the services ----------
GATEWAY_PORT=8080
CORE_PORT=4001
REFLECT_PORT=4002
BRIDGE_PORT=4003
CORE_URL=http://localhost:4001
REFLECT_URL=http://localhost:4002
BRIDGE_URL=http://localhost:4003
# the deployed web app's origin (CORS); empty = allow any origin (local)
WEB_ORIGIN=
# the day for "Seva Wisdom for Today" changes at midnight in this time zone
WISDOM_TIME_ZONE=Asia/Kolkata

# ---------- web app (only VITE_* values ever reach the browser) ----------
VITE_API_URL=http://localhost:8080

# ---------- LLM (Groq, OpenAI-compatible chat API): understanding, extraction, the dignity rewrite ----------
# Optional: with no key OR no model name, every AI job answers with its rule-based fallback.
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_RESPONSE_FORMAT=json_schema
LLM_REASONING_EFFORT=low
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0
# LLM_BASE_URL=https://api.groq.com/openai/v1/chat/completions
# Groq's free tier allows about 8000 tokens a minute; a 429 is retried once after a short wait, then the rules answer

# ---------- Bhashini: speech to text, translation, text to speech (ta / hi / en) ----------
# Optional: without keys the browser's own Web Speech and speechSynthesis are used.
LANGUAGE_PROVIDER=bhashini
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd
BHASHINI_TTS_GENDER=female
# from the Bhashini profile (optional; the config call returns them too)
BHASHINI_CONFIG_URL=https://meity-auth.ulcacontrib.org/ulca/apis/v0/model/getModelsPipeline
BHASHINI_INFERENCE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline
BHASHINI_INFERENCE_API_KEY=

# ---------- provider timeouts (ms) ----------
DRAFT_TIMEOUT_MS=8000
TRANSLATE_TIMEOUT_MS=4000

# ---------- provider order per task (first that answers wins; the browser's own APIs come after all of them) ----------
SPEECH_TO_TEXT=bhashini,groq
TEXT_TO_SPEECH=bhashini,groq
TRANSLATION=bhashini
# Groq audio: Whisper large-v3 is multilingual (Tamil, Hindi); Orpheus is English only and needs its terms accepted
# once in the Groq console (console.groq.com/playground?model=canopylabs/orpheus-v1-english)
GROQ_STT_MODEL=whisper-large-v3
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=autumn
